# cp .env.example .env
# .env는 gitignore됩니다. 커밋하지 마세요.

# Redis. host가 비어 있으면 컨테이너가 뜨지 않습니다.
SKIN_METRICS_REDIS_HOST=my-instance.ap-northeast-2-1.ec2.cloud.redislabs.com
SKIN_METRICS_REDIS_PORT=12345
SKIN_METRICS_REDIS_USER=default
SKIN_METRICS_REDIS_PASSWORD=CHANGE_ME
SKIN_METRICS_REDIS_DB=0
SKIN_METRICS_REDIS_TLS=0

# 결과가 Redis에 남아 있는 시간(초)
SKIN_METRICS_RESULT_TTL=3600

# 호스트 바인딩. 외부 노출이 필요하면 0.0.0.0
SKIN_METRICS_BIND=127.0.0.1
SKIN_METRICS_PORT=8000
