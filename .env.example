# cp .env.example .env
# .env는 gitignore됩니다. 커밋하지 마세요.

# 필수. 없으면 컨테이너가 뜨지 않습니다. TLS 인스턴스는 rediss://
SKIN_METRICS_REDIS_URL=redis://default:CHANGE_ME@my-instance.ap-northeast-2-1.ec2.cloud.redislabs.com:12345/0

# 결과가 Redis에 남아 있는 시간(초)
SKIN_METRICS_RESULT_TTL=3600

# 호스트 바인딩. 외부 노출이 필요하면 0.0.0.0
SKIN_METRICS_BIND=127.0.0.1
SKIN_METRICS_PORT=8000
